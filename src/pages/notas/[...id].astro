---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
	const notas = await getCollection('notas', ({ data }) => !data.draft);
	return notas.map((n) => ({ params: { id: n.id }, props: { n } }));
}

const { n } = Astro.props;
const { Content } = await render(n);
---

<Article title={n.data.title} description={n.data.sintoma} eyebrow={`Nota · ${n.data.categoria}`} back={{ href: '/notas/', label: 'Todas las notas' }}>
	<Content />
</Article>
