---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const proyectos = (await getCollection('proyectos', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.orden - b.data.orden,
);
---

<Base title="Proyectos" description="Homelab, scripts de administración y configuración de sistemas: qué monté, qué se rompió y qué aprendí.">
	<div class="wrap">
		<h1>Proyectos</h1>
		<p class="muted">Cada proyecto contado igual: el problema, lo que monté, lo que se rompió y lo que aprendí.</p>
		<ul class="cards">
			{
				proyectos.map((p) => (
					<li>
						<h2><a href={`/proyectos/${p.id}/`}>{p.data.title}</a></h2>
						<p>{p.data.resumen}</p>
						<p class="stack">{p.data.stack.map((s) => <span class="tag">{s}</span>)}</p>
					</li>
				))
			}
		</ul>
	</div>
</Base>

<style>
	.cards {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
	}
	li {
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 1.1rem 1.25rem;
		background: var(--bg-soft);
	}
	h2 {
		margin: 0 0 0.35rem;
		font-size: 1.15rem;
	}
	h2 a {
		color: var(--fg);
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--accent);
	}
	p {
		margin: 0 0 0.75rem;
		color: var(--muted);
	}
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
	}
</style>
