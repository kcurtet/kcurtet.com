---
import Base from './Base.astro';

interface Vecino {
	href: string;
	title: string;
}
interface Props {
	title: string;
	description?: string;
	eyebrow?: string;
	meta?: string;
	index: { href: string; label: string };
	prev?: Vecino;
	next?: Vecino;
}
const { title, description, eyebrow, meta, index, prev, next } = Astro.props;
---

<Base title={title} description={description}>
	<article class="wrap">
		<header class="head">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h1>{title}</h1>
			{meta && <p class="meta">{meta}</p>}
		</header>
		<div class="prose">
			<slot />
		</div>
		<nav class="chapter-nav" aria-label="Navegación del curso">
			{prev ? <a class="prev" href={prev.href} rel="prev">← {prev.title}</a> : <span class="prev" aria-hidden="true"></span>}
			<a class="up" href={index.href}>{index.label}</a>
			{next ? <a class="next" href={next.href} rel="next">{next.title} →</a> : <span class="next" aria-hidden="true"></span>}
		</nav>
	</article>
</Base>

<style>
	.head {
		padding-top: 1.5rem;
		margin-bottom: 2rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--line);
	}
	.meta {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
		margin: 0.75rem 0 0;
	}

	/* Lectura de capítulos largos: código con wrap, tablas con borde completo.
	   El scroll horizontal de tabla ya lo aporta global.css. */
	.prose :global(pre) {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.prose :global(table) {
		border: 1px solid var(--line);
	}
	.prose :global(th),
	.prose :global(td) {
		border: 1px solid var(--line);
		padding: 0.45rem 0.6rem;
	}
	.prose :global(th) {
		background: var(--bg-soft);
	}

	.chapter-nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 0.5rem 1rem;
		align-items: start;
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
		font-size: 0.92rem;
	}
	.chapter-nav a {
		color: var(--accent);
	}
	.prev {
		text-align: left;
	}
	.up {
		text-align: center;
		white-space: nowrap;
	}
	.next {
		text-align: right;
	}
	.prev span,
	.next span {
		display: none;
	}
	@media (max-width: 40rem) {
		.chapter-nav {
			grid-template-columns: 1fr;
			text-align: left;
		}
		.chapter-nav .up {
			order: -1;
			text-align: left;
		}
	}
</style>
