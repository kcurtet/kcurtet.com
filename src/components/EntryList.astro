---
interface Item {
	href: string;
	title: string;
	meta?: string;
	description?: string;
}
interface Props {
	items: Item[];
	empty?: string;
}
const { items, empty = 'Todavía no hay nada aquí.' } = Astro.props;
---

{
	items.length === 0 ? (
		<p class="muted">{empty}</p>
	) : (
		<ul class="entries">
			{items.map((it) => (
				<li>
					<a href={it.href}>{it.title}</a>
					{it.meta && <span class="meta">{it.meta}</span>}
					{it.description && <p>{it.description}</p>}
				</li>
			))}
		</ul>
	)
}

<style>
	.entries {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li {
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--line);
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.15rem 1rem;
		align-items: baseline;
	}
	li > a {
		font-weight: 600;
		color: var(--fg);
		text-decoration: none;
	}
	li > a:hover {
		color: var(--accent);
	}
	.meta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		white-space: nowrap;
	}
	p {
		grid-column: 1 / -1;
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
	@media (max-width: 30rem) {
		li {
			grid-template-columns: 1fr;
		}
	}
</style>
